*/

// Summary query across all devices (used by agent topic)
/*
Event
| where TimeGenerated > ago(24h)
| where EventLog == "Application"
| where EventLevelName in ("Error", "Critical")
| where EventID == 40201
| where Source == "Microsoft Dynamics - Store Commerce"
| where RenderedDescription has "InvalidAuthenticationCredentials"
| extend DeviceName = Computer
| summarize
    FailureCount = count(),
    FirstFailure = min(TimeGenerated),
    LastFailure = max(TimeGenerated),
    SampleMessage = take_any(RenderedDescription)
    by DeviceName
| order by FailureCount desc
| limit 50
*/
